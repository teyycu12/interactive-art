# Copy this file to .env (in project root OR backend/) and fill in your keys.
# .env is git-ignored.

# ── 服務監聽 ────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=5001
# DEBUG=0        # 展場請保持 0：debug 模式會洩漏 traceback 且效能較差
# SECRET_KEY=            # 未設定會退回已提交進版控的開發預設值並在啟動時警告
# CORS_ALLOWED_ORIGINS=* # 逗號分隔可收斂來源；展場 LAN 無法事前列舉故預設 *
# CHARACTER_TTL_SEC=7200 # 角色多久沒更新就自動清場（秒），0 = 不過期

# ── OpenRouter (current setup) ──────────────────────────────────────
# Key starts with sk-or-v1-...
# base_url is auto-detected from key prefix; you can override below.
OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # optional, auto-set when key starts with sk-or-

# ── Image-generation models ─────────────────────────────────────────
# IMPORTANT: only models that support OpenAI chat-completions
# `modalities=["image","text"]` work here — namely Google's Nano Banana
# family (Gemini *-flash-image / *-pro-image). FLUX models on OpenRouter
# use a different endpoint (/images/generations) and will return 404 here.
#
# full_character is the only live mode: the model draws the WHOLE figure
# (head + hair + face + body + legs + shoes) in one image. Pro-tier is
# recommended because it has to balance many parts at once; Flash-tier tends
# to drop details like shoes or paint mismatched colour patches.
FULL_CHARACTER_MODEL=google/gemini-3-pro-image-preview

# Style reference sheet (Image 4). "sheet" packs docs/style_reference/<set>/
# full_body_*.png|webp into one grid and sends it as the HOW authority; "off"
# rolls back to the three-image send for a controlled A/B. A missing set
# degrades to the same three-image send rather than failing the generation.
STYLE_REFERENCE_MODE=sheet
STYLE_REFERENCE_SET=2026q3_owner_curated

# Development defaults: do not pay for an automatic second image when local
# validation fails. Set to 1 only for an explicit retry experiment.
GENERATION_MAX_RETRIES=0

# Full-character generators already see the uploaded source photo. Leaving
# this off avoids separate outfit + face VLM calls (two requests per run).
FULL_MODE_VLM_ENABLED=0

# Local, gitignored SQLite history and generated-result previews.
DEV_HISTORY_ENABLED=1
DEV_HISTORY_SAVE_OUTPUTS=1

# Keeps a 640px, EXIF-stripped WebP copy of each source photo under
# backend/logs/inputs so a history entry can be read against the photo it came
# from. This DOES persist a picture of a real person to disk, so set it to 0
# for any run where that is not acceptable. Full-resolution base64 is still
# never stored -- note that 640px is also the ceiling on what any later CV
# investigation can see, which is why it cannot reproduce pipeline-time
# measurements taken on the full frame (see docs/STYLE_PROBE_FOLLOWUPS.md #4).
DEV_HISTORY_SAVE_INPUTS=1

# ── Generation mode ─────────────────────────────────────────────────
# full_character is the only supported value. body_sprite and
# brick_ai_texture are retired: old history stays readable, but a request for
# either is rejected before any paid call.
GENERATION_MODE=full_character

# One event uses one style. Unknown values safely fall back to lego.
CHARACTER_STYLE=lego

# Fixed-camera visual height calibration. Tune these two values on site after
# camera position, focal length, standing distance, and floor line are fixed.
HEIGHT_SHORT_MAX_RATIO=0.72
HEIGHT_TALL_MIN_RATIO=0.84

# ── Alternative: OpenAI official ────────────────────────────────────
# OPENAI_API_KEY=sk-proj-...
# OUTFIT_GEN_MODEL=gpt-image-1
# (leave OPENAI_BASE_URL unset)

# ── Gemini (existing — used by vlm_module.py for face/outfit detection) ──
GEMINI_API_KEY=

# ── M3 通訊 / 狀態管理 ───────────────────────────────────────────────
# 事件 log 落地開關（0 = 關閉，其餘 = 開啟）。展示或量測時保持開啟，
# log 寫入 backend/logs/events-YYYYMMDD.jsonl，供 analyze_log.py 分析。
EVENT_LOG_ENABLED=1

# generate_avatar 同時併發上限。多人同時拍照時超過此數會排隊，
# 避免單點瓶頸卡死（技術架構文件第 8 節風險）。現場人潮多可視機器調高。
GEN_MAX_CONCURRENT=2

# ── 合照雲端上傳（讓任何手機都能掃 QR 下載，不限同網段）──────
# 優先順序：ImgBB → Imgur。都沒填則 QR 指向 local URL（需同網段）。

# ImgBB（推薦）：到 https://imgbb.com 註冊 → https://api.imgbb.com/ 拿 API key
IMGBB_API_KEY=

# Imgur（備選）：到 https://api.imgur.com/oauth2/addclient 註冊
# 選「Anonymous usage without user authorization」拿 Client-ID
IMGUR_CLIENT_ID=


